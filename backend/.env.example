# Copy this file to backend/.env and fill in real values. Never commit .env.

ENVIRONMENT=development
APP_NAME=Subscription Management API

# Neon connection string. Neon requires SSL, so keep sslmode=require.
# Use the postgresql+psycopg:// prefix so SQLAlchemy uses the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Comma-separated origins allowed to call the API (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000

# --- Authentication ---
# Session lifetime in minutes. Sessions are stored in the auth_sessions table.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Auth cookie. Secure defaults to true unless ENVIRONMENT=development.
# If the frontend and API are on different sites, use SAMESITE=none with SECURE=true.
# AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=

# Brute-force protection (failed logins per window).
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_SECONDS=900

# --- Password reset ("Forgot password?") ---
# Link lifetime in minutes; links are single-use and a new request voids older ones.
PASSWORD_RESET_TOKEN_MINUTES=30
# Reset requests allowed per window, per email and per client IP.
PASSWORD_RESET_MAX_PER_EMAIL=3
PASSWORD_RESET_MAX_PER_IP=10
PASSWORD_RESET_WINDOW_SECONDS=900
# Base URL of the frontend; the emailed link is FRONTEND_URL/reset-password?token=...
FRONTEND_URL=http://localhost:3000

# --- Email delivery ---
# console: writes emails to the API log (the body is shown only when ENVIRONMENT=development).
# smtp: sends through the SMTP_* settings below. Use smtp anywhere real users reset passwords.
EMAIL_BACKEND=console
EMAIL_FROM=Brightloop Software <no-reply@brightloop.local>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
